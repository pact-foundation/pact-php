parameters:
    level: max
    paths:
        - src
        - tests
    treatPhpDocTypesAsCertain: false
    scanDirectories:
        - example/binary/consumer/src
        - example/binary/consumer/tests
        - example/binary/provider/tests
        - example/csv/consumer/src
        - example/csv/consumer/tests
        - example/csv/provider/tests
        - example/form-urlencoded/consumer/src
        - example/form-urlencoded/consumer/tests
        - example/form-urlencoded/provider/tests
        - example/generators/consumer/src
        - example/generators/consumer/tests
        - example/generators/provider/tests
        - example/graphql/consumer/src
        - example/graphql/consumer/tests
        - example/graphql/provider/tests
        - example/json/consumer/src
        - example/json/consumer/tests
        - example/json/provider/src
        - example/json/provider/tests
        - example/matchers/consumer/src
        - example/matchers/consumer/tests
        - example/matchers/provider/tests
        - example/message/consumer/src
        - example/message/consumer/tests
        - example/message/provider/src
        - example/message/provider/tests
        - example/multipart/consumer/src
        - example/multipart/consumer/tests
        - example/multipart/provider/tests
        - example/protobuf-async-message/consumer/src
        - example/protobuf-async-message/consumer/tests
        - example/protobuf-async-message/library/src
        - example/protobuf-async-message/provider/tests
        - example/protobuf-sync-message/consumer/tests
        - example/protobuf-sync-message/library/src
        - example/protobuf-sync-message/provider/src
        - example/protobuf-sync-message/provider/tests
        - example/server-sent-events/consumer/src
        - example/server-sent-events/consumer/tests
        - example/server-sent-events/provider/tests
        - example/stub-server/consumer/src
        - example/stub-server/consumer/tests
        - example/xml/consumer/src
        - example/xml/consumer/tests
        - example/xml/provider/tests
