parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$array of function implode expects array\<string\>, array\<mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/PhpPact/Consumer/Matcher/Matchers/MatchAll.php

		-
			message: '#^Cannot access offset int\<0, max\> on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/PhpPact/FFI/Model/ArrayData.php

		-
			message: '#^Parameter \#1 \$items of class PhpPact\\FFI\\Model\\ArrayData constructor expects FFI\\CData, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: src/PhpPact/FFI/Model/ArrayData.php

		-
			message: '#^Static call to instance method FFI\:\:new\(\)\.$#'
			identifier: method.staticCall
			count: 2
			path: src/PhpPact/FFI/Model/ArrayData.php

		-
			message: '#^Static call to instance method FFI\:\:new\(\)\.$#'
			identifier: method.staticCall
			count: 1
			path: src/PhpPact/FFI/Model/BinaryData.php

		-
			message: '#^Method PhpPact\\Standalone\\ProviderVerifier\\Model\\Selector\\Selector\:\:jsonSerialize\(\) should return array\<string, bool\|string\> but returns array\<bool\|string\>\.$#'
			identifier: return.type
			count: 1
			path: src/PhpPact/Standalone/ProviderVerifier/Model/Selector/Selector.php

		-
			message: '#^Parameter \#1 \$callback of method Symfony\\Component\\Process\\Process\:\:waitUntil\(\) expects callable\(''err''\|''out'', string\)\: bool, Closure\(string, string\)\: \(0\|1\|false\) given\.$#'
			identifier: argument.type
			count: 1
			path: src/PhpPact/Standalone/StubService/StubServer.php

		-
			message: '#^Static call to instance method FFI\:\:new\(\)\.$#'
			identifier: method.staticCall
			count: 1
			path: tests/PhpPact/Standalone/ProviderVerifier/VerifierTest.php
